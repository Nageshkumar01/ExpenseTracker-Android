<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="14dp" app:cardElevation="1dp"
    app:strokeColor="#E8ECF3" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Lunch" android:textColor="#63E036"
                android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvMeta" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="Food • 2026-06-15" android:textColor="#FF5801" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="−₹250.00" android:textColor="#B42318"
            android:textSize="15sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/btnDelete" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete transaction" android:src="@android:drawable/ic_menu_delete"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
